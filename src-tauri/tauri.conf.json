{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Daiwari Manager",
  "version": "1.5.7",
  "identifier": "com.daidori.manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "台割マネージャー",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "center": true,
        "visible": false,
        "dragDropEnabled": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost https://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/noguchi-kosei-del/daidori-manager-tauri/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNFRUM1ODVDM0NEMDU2OUYKUldTZlZ0QThYRmpzUHY1bCsyd1hUZzd0d2FXT3M5QWU1VUJZVHY2S2ZnMEFTTi9jZ3g3d0FKQ0wK"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "scripts/",
      "resources/kadokawa_css/",
      "resources/hybrid_legacy_css/",
      "binaries/pdfium.dll"
    ],
    "fileAssociations": [
      {
        "ext": ["daiw"],
        "name": "DaiwariProject",
        "description": "台割マネージャー プロジェクトファイル",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "languages": ["Japanese"],
        "displayLanguageSelector": false
      }
    }
  }
}
